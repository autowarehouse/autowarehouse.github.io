{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autowarehouse-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-30",
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@autowarehouse.ai"] }],
  "routes": [{ "pattern": "autowarehouse.ai/api/contact", "zone_name": "autowarehouse.ai" }],
  "vars": { "CONTACT_TO": "info@intellica.net", "CONTACT_FROM": "noreply@autowarehouse.ai" },
  "observability": { "enabled": true },
}
