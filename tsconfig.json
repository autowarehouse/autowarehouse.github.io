{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"]
    },
    // Bun runtime types for the `bun:test` imports in *.test.ts. @types/bun also
    // references @types/node, covering Node globals. Astro's ambient types load
    // via .astro/types.d.ts (triple-slash), which the `types` array does not gate.
    "types": ["bun"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
