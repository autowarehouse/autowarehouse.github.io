---
import '@/styles/global.css';
import CookieConsent from '@components/common/CookieConsent.astro';
import { FEATURES } from '@data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL('/og/default.png', Astro.site).toString();

// BreadcrumbList for non-home pages: Home → current page (valid + simple; the
// title prop is the page's own name, incl. feature names on /features/[slug]).
const breadcrumb =
  canonicalUrl.pathname === '/'
    ? null
    : {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
          { '@type': 'ListItem', position: 2, name: title, item: canonicalUrl.toString() },
        ],
      };
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16110c" />

    <!-- Theme: set before paint to prevent flash. Default = dark. -->
    <script is:inline>
      (function () {
        var t = 'dark';
        try {
          var saved = localStorage.getItem('aw-theme');
          if (saved === 'light' || saved === 'dark') t = saved;
        } catch (e) {
          /* storage blocked — fall back to dark */
        }
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', t === 'light' ? '#d9cdb4' : '#16110c');
      })();
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="AutoWarehouse" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title} | AutoWarehouse</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | AutoWarehouse`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | AutoWarehouse`} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts: Archivo + Anton (display) · Space Grotesk (body) · JetBrains Mono (data) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@600;700;800;900&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Consent Mode v2 + gtag.js -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 1500,
      });
      try {
        if (localStorage.getItem('cookie-consent') === 'accepted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {
        /* storage blocked — leave analytics denied */
      }
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZENXMKC3ET"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-ZENXMKC3ET', { anonymize_ip: true });
    </script>

    <!--
      Analytics event helper (issue #11). window.awTrack(name, params) is a global
      no-op unless gtag is present, so every caller stays safe when GA is blocked or
      consent is denied. Consent Mode v2 (above) keeps these events cookieless until
      the visitor accepts. Defined before body scripts so the game/form/theme islands
      can call it. Also delegates primary-CTA and outbound-link tracking site-wide so
      individual pages need no per-element wiring.
    -->
    <script is:inline>
      window.awTrack = function (name, params) {
        try {
          if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
        } catch (e) {
          /* never let analytics break the page */
        }
      };
      (function () {
        function onReady(fn) {
          if (document.readyState !== 'loading') fn();
          else document.addEventListener('DOMContentLoaded', fn);
        }
        onReady(function () {
          document.addEventListener(
            'click',
            function (e) {
              var el = e.target && e.target.closest ? e.target.closest('a, button') : null;
              if (!el) return;
              // Outbound links → a different host
              if (el.tagName === 'A' && el.href) {
                var url = null;
                try {
                  url = new URL(el.href, window.location.href);
                } catch (err) {
                  /* not a resolvable URL */
                }
                if (url && url.host && url.host !== window.location.host && /^https?:$/.test(url.protocol)) {
                  window.awTrack('outbound_click', { link_url: url.href, link_domain: url.host });
                }
              }
              // Primary calls-to-action → .btn-primary / .btn-accent
              if (el.classList && (el.classList.contains('btn-primary') || el.classList.contains('btn-accent'))) {
                window.awTrack('cta_click', {
                  cta_text: (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80),
                  cta_href: el.getAttribute('href') || '',
                  page_path: window.location.pathname,
                });
              }
            },
            true,
          );
        });
      })();
    </script>

    <!-- Structured Data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            name: 'Intellica',
            url: 'https://www.intellica.net',
            logo: 'https://www.intellica.net/img/intellica-logo.png',
            foundingDate: '2006',
            numberOfEmployees: { '@type': 'QuantitativeValue', minValue: 450 },
            address: {
              '@type': 'PostalAddress',
              streetAddress: 'Atatürk Mah. Turgut Özal Blv. Gardenya 1 Plaza, Floor 1',
              addressLocality: 'Ataşehir, Istanbul',
              addressCountry: 'TR',
            },
            contactPoint: {
              '@type': 'ContactPoint',
              telephone: '+90-216-688-45-46',
              email: 'info@intellica.net',
              contactType: 'sales',
            },
            sameAs: ['https://www.linkedin.com/company/intellica'],
            parentOrganization: { '@type': 'Organization', name: 'PiA Group' },
          },
          {
            '@type': 'SoftwareApplication',
            name: 'AutoWarehouse',
            url: 'https://autowarehouse.ai',
            applicationCategory: 'BusinessApplication',
            applicationSubCategory: 'Data Warehouse Automation',
            operatingSystem: 'Web',
            description: description,
            featureList: FEATURES.map((f) => f.name),
            creator: { '@type': 'Organization', name: 'Intellica', url: 'https://www.intellica.net' },
            offers: { '@type': 'Offer', category: 'Enterprise' },
            sameAs: ['https://github.com/autowarehouse', 'https://www.linkedin.com/company/autowarehouse'],
          },
          { '@type': 'WebSite', name: 'AutoWarehouse', url: 'https://autowarehouse.ai' },
          ...(breadcrumb ? [breadcrumb] : []),
        ],
      })}
    />

    <!-- Page-specific head content (e.g. per-page JSON-LD) -->
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <CookieConsent />
  </body>
</html>
