---
import PageLayout from '@layouts/PageLayout.astro';
import { CONTACT } from '@data/site';

const updated = 'June 2026';

const cookieRows = [
  {
    state: 'Before consent',
    glyph: '◇',
    desc: 'Scripts load but set no cookies and collect no personal data. We receive only anonymous, cookieless signals.',
  },
  {
    state: 'If you accept',
    glyph: '✓',
    desc: 'First-party cookies record session duration and traffic source. Your IP address is anonymized.',
  },
  {
    state: 'If you decline',
    glyph: '✕',
    desc: 'No cookies are set. Your choice is stored in your browser local storage so we remember it.',
  },
];
---

<PageLayout
  title="Privacy Policy"
  description="AutoWarehouse is a product of Intellica (a PiA Group company). We are committed to protecting your privacy and being transparent about how we collect and use data."
>
  <!-- hero -->
  <section class="ph grid-bg">
    <div class="shell ph-inner">
      <div class="eyebrow">Legal</div>
      <h1 class="ph-h1">Privacy <span class="highlight">Policy</span></h1>
      <p class="ph-meta mono-label">Last updated · {updated}</p>
    </div>
  </section>

  <!-- prose -->
  <section class="shell pp">
    <article class="panel prose reveal">
      <p class="lead">
        AutoWarehouse is a product of Intellica (a PiA Group company). We are committed to protecting your privacy and
        being transparent about how we collect and use data.
      </p>

      <div class="divider-dashed"></div>

      <h2 id="cookies">Cookies &amp; Analytics</h2>
      <p>
        We use Google Analytics 4 with Consent Mode v2. Your consent choice determines exactly what is collected at
        every stage:
      </p>
      <ul class="cookie-list">
        {
          cookieRows.map((r) => (
            <li class="cookie-item">
              <span class="cookie-glyph" aria-hidden="true">
                {r.glyph}
              </span>
              <div>
                <span class="cookie-state">{r.state}</span>
                <span class="cookie-desc">{r.desc}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <h2 id="rights">Your Rights</h2>
      <p>
        You can change your preference at any time by clearing your browser local storage, which resets your consent
        choice. Under the GDPR, you also have the right to access, correct, and delete the personal data we hold about
        you.
      </p>

      <h2 id="contact">Contact</h2>
      <p>
        For any privacy question or to exercise your rights, reach us at
        {' '}<a class="mail" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
      </p>
    </article>
  </section>
</PageLayout>

<style>
  /* hero */
  .ph {
    position: relative;
    overflow: hidden;
  }
  .ph-inner {
    padding-top: 40px;
    padding-bottom: 30px;
  }
  .ph-h1 {
    margin: 14px 0 0;
    font: 900 clamp(38px, 6vw, 72px)/0.9 var(--font-display);
    letter-spacing: -0.05em;
    color: var(--ink);
  }
  .ph-meta {
    margin: 18px 0 0;
  }

  /* prose container */
  .pp {
    padding-top: 40px;
    padding-bottom: 80px;
  }
  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(26px, 5vw, 48px);
  }
  .prose .lead {
    margin: 0;
    font: 500 clamp(16px, 2vw, 19px)/1.55 var(--font-body);
    color: var(--ink);
  }
  .prose .divider-dashed {
    margin: 28px 0;
  }
  .prose h2 {
    margin: 36px 0 12px;
    font: 800 clamp(20px, 2.6vw, 26px) var(--font-display);
    letter-spacing: -0.03em;
    color: var(--ink);
    scroll-margin-top: 90px;
  }
  .prose h2::before {
    content: '◆';
    margin-right: 10px;
    font-size: 0.7em;
    color: var(--orange);
    vertical-align: 1px;
  }
  .prose p {
    margin: 0 0 14px;
    font: 400 15px/1.7 var(--font-body);
    color: var(--ink-muted);
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .mail {
    color: var(--orange);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--orange) 45%, transparent);
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .mail:hover {
    border-bottom-color: var(--orange);
  }

  /* cookie consent list */
  .cookie-list {
    list-style: none;
    margin: 4px 0 6px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .cookie-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 16px;
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--orange);
    border-radius: 11px;
    background: var(--panel-2);
  }
  .cookie-glyph {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--orange) 14%, transparent);
    color: var(--orange);
    font: 800 13px var(--font-mono);
    margin-top: 1px;
  }
  .cookie-state {
    display: block;
    font: 700 11px var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .cookie-desc {
    display: block;
    margin-top: 5px;
    font: 400 14px/1.6 var(--font-body);
    color: var(--ink-muted);
  }
</style>
