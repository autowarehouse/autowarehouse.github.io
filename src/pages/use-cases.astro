---
import PageLayout from '@layouts/PageLayout.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';

const ENTRIES = [
  {
    icon: 'template',
    label: 'Ready-Made',
    text: 'Use a ready-made industry model',
    accent: 'var(--orange)',
    href: '#uc-01',
  },
  {
    icon: 'extend',
    label: 'Extend',
    text: 'Extend an existing model with new requirements',
    accent: 'var(--yellow)',
    href: '#uc-02',
  },
  {
    icon: 'build',
    label: 'Build',
    text: 'Build from scratch — discover, model, map, generate',
    accent: 'var(--green)',
    href: '#uc-03',
  },
];

const CASES = [
  {
    id: 'uc-01',
    no: '01',
    icon: 'template',
    accent: 'var(--orange)',
    title: 'Deploy a Ready-Made Industry Model',
    subtitle: 'From zero to analytics-ready DWH in days, not months',
    desc: 'Your organization needs a data warehouse but has no existing model. Pick a battle-tested industry template — Finance (IFDM), Telecom (ITDM), HR (HRDM), or others — and deploy a fully structured star-schema DWH with pre-built dimensions, fact tables, and SCD Type 2 handling.',
    scenarioLabel: 'A mid-size bank · regulatory reporting',
    scenario:
      "A mid-size bank wants to consolidate regulatory reporting. They connect their core banking system, select the IFDM (Finance Data Model), and AutoWarehouse instantly provisions Foundation, Analytical, and Semantic layers. The ETL Code Generator exports production-ready Airflow DAGs and dbt models — deployed to the bank's own infrastructure within a week.",
    caps: [
      {
        t: 'Industry Templates',
        d: 'Refined across 80+ projects. Star-schema with dimensions, facts, bridges, and SCD Type 2.',
      },
      {
        t: 'Database DNA Report',
        d: 'Row counts, profiling, heavily-used vs zero-record detection, reference/lookup classification, anomaly flags.',
      },
      {
        t: 'Deterministic Code Generation',
        d: 'Zero hallucination. Airflow, dbt, Snowflake, Spark, PL/SQL — independently versioned, licensable plugins.',
      },
    ],
    outcome:
      'Analytics-ready data warehouse with production ETL code, deployed on your own infrastructure. Weeks instead of months.',
  },
  {
    id: 'uc-02',
    no: '02',
    icon: 'extend',
    accent: 'var(--yellow)',
    title: 'Extend & Customize an Existing Model',
    subtitle: 'Evolve your DWH with new requirements — without starting over',
    desc: 'You already have a data model or a partial warehouse. Import it, overlay new business requirements, and let AutoWarehouse extend the model — adding dimensions, facts, or entire subject areas while preserving what already works.',
    scenarioLabel: 'A telecom operator · churn prediction',
    scenario:
      "A telecom operator has been running ITDM for 3 years. New regulatory requirements demand a customer churn prediction subject area. They import their existing model, add new source tables from the CRM, and use the table-level mapping screen to see the full source-to-target picture. The AI suggests column mappings for new tables while preserving all existing mappings. A 'Save as New Version' snapshot ensures rollback safety. The ETL plugin generates incremental dbt models that slot into their existing pipeline.",
    caps: [
      {
        t: 'Source-to-Target Table Mapping',
        d: 'Full table-level view of the entire warehouse — spot coverage gaps at a glance.',
      },
      {
        t: 'Similar Column Detection',
        d: 'Sidebar highlights similar/identical names across tables: join candidates, duplicates, standardization.',
      },
      {
        t: 'Model Versioning',
        d: 'Save as a new copy. Branch, experiment, compare — with full version history and rollback.',
      },
    ],
    outcome:
      'Extended data model with surgical precision — new subject areas integrated without disrupting existing production pipelines.',
  },
  {
    id: 'uc-03',
    no: '03',
    icon: 'build',
    accent: 'var(--green)',
    title: 'Build from Scratch with AI Discovery',
    subtitle: 'From business requirements to a fully modeled DWH — AI-assisted, human-approved',
    desc: 'No existing model, complex source systems, specific business requirements. AutoWarehouse connects to your sources, generates a comprehensive Database DNA report, helps you design the target model from discovered insights, and maps everything — with human review and approval at every step.',
    scenarioLabel: 'A manufacturing conglomerate · 12 ERP instances',
    scenario:
      'A manufacturing conglomerate with 12 ERP instances across 4 countries needs a unified analytics platform. AutoWarehouse connects to all source systems and generates a Database DNA report: 2,400 tables profiled, 847 identified as actively used, 340 flagged as reference/lookup tables, 198 anomalies detected. The AI generates a comprehensive database dictionary with column-level documentation. Data engineers review and approve the discovery. They design a custom target model using insights from the DNA report, map all 847 active tables, and export PL/SQL ETL scripts and Spark jobs — all verified and approved before any code touches production.',
    caps: [
      {
        t: 'Comprehensive Database Discovery',
        d: 'Inductive analysis: row counts, profiling, anomaly detection, table classification — an interactive, customer-facing report.',
      },
      {
        t: 'AI-Generated Database Dictionary',
        d: 'Auto docs per table and column: inferred descriptions, data types, relationships, quality scores — with human review.',
      },
      {
        t: 'Data Quality Dashboard',
        d: 'Real-time null %, record counts, unique distributions, anomaly alerts, and completeness scores.',
      },
      {
        t: 'Plugin-Based ETL Export',
        d: 'Deterministic exporters for Airflow, dbt, Snowflake, Spark, PL/SQL — each an independent plugin.',
      },
    ],
    outcome:
      'A fully documented, quality-assessed, mapped, and code-generated DWH — built from scratch with full traceability from source discovery to production deployment.',
  },
];

const CROSS = [
  {
    glyph: '◆',
    t: 'Deterministic ETL',
    d: '100% deterministic code generation — predictable, auditable, and production-safe. No hallucination, ever.',
  },
  {
    glyph: '⬡',
    t: 'Plugin Architecture',
    d: 'Independent exporters, individually versioned and licensable, with backward-compatible upgrades.',
  },
  {
    glyph: '✓',
    t: 'Human-in-the-Loop',
    d: 'AI assists; humans review, approve, and control. Nothing reaches production without explicit approval.',
  },
];
---

<PageLayout
  title="Use Cases"
  description="Three paths to your data warehouse: deploy a ready-made model, extend an existing one, or build from scratch with AI-assisted discovery. Real enterprise scenarios backed by 20 years of DWH expertise."
>
  <!-- HERO -->
  <section class="hero grid-bg">
    <div class="shell hero-inner">
      <div class="eyebrow">Use Cases</div>
      <h1 class="hero-h1">
        Three Paths to Your<br /><span class="highlight">Data Warehouse</span>
      </h1>
      <p class="hero-sub">
        Every DWH project starts differently. AutoWarehouse meets you where you are — whether you need
        a turnkey deployment, an incremental extension, or a greenfield build from source discovery.
      </p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-primary">Request Demo</a>
        <a href="/platform" class="btn btn-outline">Explore Platform</a>
      </div>
    </div>
  </section>

  <!-- ENTRY POINTS -->
  <section class="shell entries-sec">
    <div class="entries">
      {ENTRIES.map((e, i) => (
        <a href={e.href} class="entry reveal" style={`--c:${e.accent}`}>
          <span class="entry-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="entry-glyph"><Icon name={e.icon} size={30} /></span>
          <span class="entry-label">{e.label}</span>
          <span class="entry-text">{e.text}</span>
          <span class="entry-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- USE-CASE BLOCKS -->
  {CASES.map((uc) => (
    <section id={uc.id} class="uc reveal" style={`--c:${uc.accent}`}>
      <div class="shell">
        <div class="uc-head">
          <div class="uc-no">{uc.no}</div>
          <div class="uc-head-text">
            <div class="uc-eyebrow">
              <span class="uc-glyph"><Icon name={uc.icon} size={15} /></span> Path {uc.no}
            </div>
            <h2 class="uc-title">{uc.title}</h2>
            <p class="uc-subtitle">{uc.subtitle}</p>
          </div>
        </div>

        <p class="uc-desc">{uc.desc}</p>

        <div class="uc-scenario panel-2">
          <div class="uc-scenario-head">
            <span class="uc-scenario-tag">Real-World Scenario</span>
            <span class="uc-scenario-sub">{uc.scenarioLabel}</span>
          </div>
          <p class="uc-scenario-body">{uc.scenario}</p>
        </div>

        <div class="uc-caps">
          {uc.caps.map((c, i) => (
            <div class="uc-cap reveal">
              <span class="uc-cap-no">{String(i + 1).padStart(2, '0')}</span>
              <div class="uc-cap-t">{c.t}</div>
              <div class="uc-cap-d">{c.d}</div>
            </div>
          ))}
        </div>

        <div class="uc-outcome">
          <span class="uc-outcome-k">Outcome</span>
          <span class="uc-outcome-v">{uc.outcome}</span>
        </div>
      </div>
    </section>
  ))}

  <!-- CROSS-CUTTING -->
  <section class="shell cross-sec">
    <SectionHeading
      eyebrow="Across every path"
      title="Built on the same guarantees"
      lead="Whichever way you start, the same engineering principles hold — from the first profiled table to the code that ships to production."
    />
    <div class="cross-grid">
      {CROSS.map((c) => (
        <div class="cross-card reveal">
          <span class="cross-glyph" aria-hidden="true">{c.glyph}</span>
          <div class="cross-t">{c.t}</div>
          <div class="cross-d">{c.d}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="shell cta-sec">
    <div class="cta-card card-frame grid-bg reveal">
      <h2 class="cta-h">Which path fits<br />your project?</h2>
      <p class="cta-lead">
        Tell us about your data warehouse needs. We'll show you the fastest path to production.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary cta-btn">Request Demo</a>
        <a href="/platform" class="btn btn-outline cta-btn">Explore Platform</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; }
  .hero-inner { padding-top: 40px; padding-bottom: 34px; }
  .hero-h1 { margin: 14px 0 0; font: 900 clamp(38px, 6vw, 72px)/0.88 var(--font-display); letter-spacing: -0.05em; color: var(--ink); }
  .hero-sub { max-width: 620px; margin: 24px 0 0; font: 400 clamp(14px, 1.6vw, 17px)/1.6 var(--font-mono); color: var(--ink-muted); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  /* ENTRY POINTS */
  .entries-sec { padding-top: 48px; }
  .entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .entry {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    padding: 22px 22px 20px; border: 1px solid var(--line-soft); border-left: 3px solid var(--c);
    border-radius: 14px; background: var(--panel); text-decoration: none;
    transition: transform .18s, border-color .2s;
  }
  .entry:hover { transform: translateY(-4px); border-color: var(--c); }
  .entry-no { font: 800 11px var(--font-mono); color: var(--c); }
  .entry-glyph { display: inline-flex; color: var(--c); }
  .entry-label { font: 700 11px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--c); }
  .entry-text { font: 700 16px/1.3 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .entry-arrow { margin-top: 2px; font: 900 18px var(--font-display); color: var(--c); transition: transform .2s; }
  .entry:hover .entry-arrow { transform: translateX(5px); }

  /* USE-CASE BLOCK */
  .uc { padding-top: 60px; }
  .uc + .uc { border-top: 1px dashed var(--line); }
  .uc-head { display: flex; align-items: flex-start; gap: clamp(14px, 3vw, 28px); }
  .uc-no {
    flex: none; font: 900 clamp(48px, 9vw, 96px)/0.8 var(--font-display);
    letter-spacing: -0.05em; color: color-mix(in srgb, var(--c) 32%, transparent);
    -webkit-text-stroke: 1px var(--c);
  }
  .uc-head-text { min-width: 0; }
  .uc-eyebrow { display: flex; align-items: center; gap: 8px; font: 700 11px var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--c); }
  .uc-glyph { display: inline-flex; vertical-align: middle; color: var(--c); }
  .uc-title { margin: 10px 0 0; font: 900 clamp(24px, 3.4vw, 40px)/1 var(--font-display); letter-spacing: -0.04em; color: var(--ink); }
  .uc-subtitle { margin: 10px 0 0; font: 600 clamp(14px, 1.7vw, 18px)/1.4 var(--font-body); color: var(--c); }
  .uc-desc { max-width: 760px; margin: 22px 0 0; font: 400 15px/1.65 var(--font-body); color: var(--ink-muted); }

  /* SCENARIO CALLOUT */
  .uc-scenario {
    margin-top: 26px; padding: 22px 24px;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 8%, var(--panel-2));
  }
  .uc-scenario-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin-bottom: 12px; }
  .uc-scenario-tag {
    font: 800 10px var(--font-mono); text-transform: uppercase; letter-spacing: .12em;
    color: var(--on-accent); background: var(--c); padding: 5px 10px; border-radius: 6px;
  }
  .uc-scenario-sub { font: 600 11px var(--font-mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-dim); }
  .uc-scenario-body { margin: 0; font: 400 14px/1.7 var(--font-mono); color: var(--ink); }

  /* CAPABILITY CARDS */
  .uc-caps { margin-top: 26px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .uc-cap {
    position: relative; padding: 20px 20px; border: 1px solid var(--line-soft);
    border-radius: 12px; background: var(--panel); border-top: 3px solid var(--c);
    transition: transform .18s, border-color .2s;
  }
  .uc-cap:hover { transform: translateY(-3px); border-color: var(--c); }
  .uc-cap-no { font: 800 11px var(--font-mono); color: var(--c); }
  .uc-cap-t { margin-top: 9px; font: 800 16px/1.25 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .uc-cap-d { margin-top: 8px; font: 400 13.5px/1.55 var(--font-body); color: var(--ink-muted); }

  /* OUTCOME */
  .uc-outcome {
    margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
    padding: 20px 22px; border: 2px solid var(--c); border-radius: 14px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--c) 12%, transparent), transparent);
  }
  .uc-outcome-k {
    flex: none; font: 900 11px var(--font-mono); text-transform: uppercase; letter-spacing: .12em;
    color: var(--on-accent); background: var(--c); padding: 6px 11px; border-radius: 6px;
  }
  .uc-outcome-v { font: 700 clamp(15px, 1.9vw, 19px)/1.4 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }

  /* CROSS-CUTTING */
  .cross-sec { padding-top: 72px; }
  .cross-grid { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .cross-card {
    padding: 24px 22px; border: 1px solid var(--line-soft); border-radius: 14px;
    background: var(--panel); transition: transform .18s, border-color .2s;
  }
  .cross-card:hover { transform: translateY(-4px); border-color: var(--yellow); }
  .cross-glyph { display: inline-block; font: 900 22px var(--font-display); color: var(--yellow); }
  .cross-t { margin-top: 14px; font: 800 18px/1.2 var(--font-display); letter-spacing: -0.02em; color: var(--ink); }
  .cross-d { margin-top: 10px; font: 400 14px/1.6 var(--font-body); color: var(--ink-muted); }

  /* CTA */
  .cta-sec { padding-top: 72px; padding-bottom: 80px; }
  .cta-card { position: relative; overflow: hidden; padding: clamp(34px, 5vw, 60px); text-align: center; }
  .cta-h { margin: 0; font: 900 clamp(30px, 5vw, 60px)/0.88 var(--font-display); letter-spacing: -0.05em; color: var(--ink); }
  .cta-lead { max-width: 520px; margin: 20px auto 0; font: 400 15px/1.6 var(--font-mono); color: var(--ink-muted); }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .cta-btn { min-height: 52px; padding: 0 26px; font-size: 13px; }

  @media (max-width: 520px) {
    .uc-head { flex-direction: column; gap: 6px; }
  }
</style>
