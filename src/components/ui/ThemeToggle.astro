---
/** Dark/light theme toggle. Default dark; persisted in localStorage as 'aw-theme'. */
---

<button id="aw-theme-toggle" type="button" class="aw-toggle" aria-label="Toggle color theme" title="Toggle theme">
  <svg
    class="ic-sun"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"
    ></path>
  </svg>
  <svg
    class="ic-moon"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  .aw-toggle {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    background: var(--panel-2);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
  }
  .aw-toggle:hover {
    border-color: var(--orange);
    color: var(--orange);
    transform: translateY(-1px);
  }
  .aw-toggle svg {
    display: none;
  }
  :global([data-theme='dark']) .aw-toggle .ic-sun {
    display: block;
  } /* dark → show sun (go light) */
  :global([data-theme='light']) .aw-toggle .ic-moon {
    display: block;
  } /* light → show moon (go dark) */
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('aw-theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('aw-theme', next);
      } catch (e) {}
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'light' ? '#d9cdb4' : '#16110c');
      window.awTrack?.('theme_change', { theme: next });
    });
  })();
</script>
