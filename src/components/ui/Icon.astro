---
/**
 * Industrial line-icon set (stroke, currentColor) — matches the Logo / ThemeToggle
 * aesthetic. Color is inherited via currentColor; size via the `size` prop.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = '' } = Astro.props;

const PATHS: Record<string, string> = {
  // use-cases
  template: '<path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z"/><path d="M3 12l9 4.5L21 12"/><path d="M3 16.5 12 21l9-4.5"/>',
  extend:
    '<path d="M4 7.5h3.2a2.3 2.3 0 1 1 4.6 0H15v3.3a2.3 2.3 0 1 1 0 4.6V18.5h-3.2a2.3 2.3 0 1 0-4.6 0H4v-3.2a2.3 2.3 0 1 0 0-4.6V7.5Z"/>',
  build:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/><circle cx="15.5" cy="15.5" r="1.4"/>',
  // industries
  finance: '<path d="M3 10 12 4l9 6"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"/><path d="M3 21h18"/>',
  telecom:
    '<circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4"/><path d="M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/>',
  public: '<path d="m5 8 7-4 7 4"/><path d="M5 8h14"/><path d="M7 8v9M12 8v9M17 8v9"/><path d="M4 21h16"/>',
  manufacturing: '<path d="M3 21V10l6 3.5V10l6 3.5V7l6 4v10H3Z"/><path d="M3 21h18"/>',
  energy: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  retail: '<path d="M6 8h12l-1 11a2 2 0 0 1-2 1.8H9a2 2 0 0 1-2-1.8L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  insurance: '<path d="M12 3 20 6v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z"/><path d="m8.5 12 2.2 2.2L15.5 9.5"/>',
};

const d = PATHS[name] ?? '';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={d}
/>
