---
/**
 * AutoWarehouse "Agent Ribbon" logo.
 * Three stacked layers (foundation/analytical/semantic) bound by an
 * orange ribbon (the AI agent) weaving through them.
 *
 *  variant: 'lockup' (mark + wordmark) | 'mark' (ribbon only) | 'hex' (AW badge)
 */
interface Props {
  variant?: 'lockup' | 'mark' | 'hex';
  size?: number;
  tagline?: boolean;
  class?: string;
}
const { variant = 'lockup', size = 32, tagline = false, class: cls = '' } = Astro.props;
---

{
  variant === 'hex' && (
    <span class={`hex-mark ${cls}`} style={`width:${size}px;height:${size}px`} aria-hidden="true">
      AW
    </span>
  )
}

{
  variant === 'mark' && (
    <svg width={size} height={size} viewBox="0 0 64 64" class={cls} role="img" aria-label="AutoWarehouse">
      <polygon points="18,13 46,13 39,21 11,21" fill="none" stroke="currentColor" stroke-width="2.5" />
      <polygon points="18,29 46,29 39,37 11,37" fill="none" stroke="currentColor" stroke-width="2.5" />
      <polygon points="18,45 46,45 39,53 11,53" fill="none" stroke="currentColor" stroke-width="2.5" />
      <path
        d="M10 17 C 30 17, 34 33, 54 33 C 34 33, 30 49, 10 49"
        fill="none"
        stroke="var(--orange)"
        stroke-width="3.6"
        stroke-linecap="round"
      />
    </svg>
  )
}

{
  variant === 'lockup' && (
    <span class={`aw-lockup ${cls}`}>
      <span class="hex-mark" style={`width:${size}px;height:${size}px`} aria-hidden="true">
        AW
      </span>
      <span class="aw-words">
        <span class="aw-wordmark" style={`font-size:${Math.round(size * 0.5)}px`}>
          Auto<span class="aw-mut">Warehouse</span>
        </span>
        {tagline && <span class="aw-tag">agent flows · model holds</span>}
      </span>
    </span>
  )
}

<style>
  .aw-lockup {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--ink);
  }
  .aw-words {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .aw-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .aw-mut {
    opacity: 0.55;
  }
  .aw-tag {
    margin-top: 3px;
    font: 700 8px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
</style>
