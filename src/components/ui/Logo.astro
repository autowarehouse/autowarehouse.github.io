---
/**
 * AutoWarehouse "Agent Weave" logo.
 * Three stacked layers (foundation/analytical/semantic) with an orange ribbon
 * (the AI agent) weaving vertically through them.
 *
 *  variant: 'lockup' (mark + wordmark) | 'mark' (weave only) | 'hex' (AW badge)
 *
 * The mark's slabs use `currentColor` (so they follow --ink per theme); the
 * ribbon is always --orange. Static asset masters live in src/assets/brand/.
 */
interface Props {
  variant?: 'lockup' | 'mark' | 'hex';
  size?: number;
  tagline?: boolean;
  class?: string;
}
const { variant = 'lockup', size = 32, tagline = false, class: cls = '' } = Astro.props;
---

{
  variant === 'hex' && (
    <span class={`hex-mark ${cls}`} style={`width:${size}px;height:${size}px`} aria-hidden="true">
      AW
    </span>
  )
}

{
  variant === 'mark' && (
    <svg width={size} height={size} viewBox="0 0 64 64" class={cls} role="img" aria-label="AutoWarehouse">
      <polygon points="16,12 48,12 40,22 8,22" fill="none" stroke="currentColor" stroke-width="2.5" />
      <polygon points="16,28 48,28 40,38 8,38" fill="none" stroke="currentColor" stroke-width="2.5" />
      <polygon points="16,44 48,44 40,54 8,54" fill="none" stroke="currentColor" stroke-width="2.5" />
      <path
        d="M40 6 C 20 14, 20 24, 32 26 C 44 28, 44 38, 28 41 C 14 43, 16 52, 30 58"
        fill="none"
        stroke="var(--orange)"
        stroke-width="3.4"
        stroke-linecap="round"
      />
    </svg>
  )
}

{
  variant === 'lockup' && (
    <span class={`aw-lockup ${cls}`}>
      <svg class="aw-mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
        <polygon points="16,12 48,12 40,22 8,22" fill="none" stroke="currentColor" stroke-width="2.5" />
        <polygon points="16,28 48,28 40,38 8,38" fill="none" stroke="currentColor" stroke-width="2.5" />
        <polygon points="16,44 48,44 40,54 8,54" fill="none" stroke="currentColor" stroke-width="2.5" />
        <path
          d="M40 6 C 20 14, 20 24, 32 26 C 44 28, 44 38, 28 41 C 14 43, 16 52, 30 58"
          fill="none"
          stroke="var(--orange)"
          stroke-width="3.4"
          stroke-linecap="round"
        />
      </svg>
      <span class="aw-words">
        <span class="aw-wordmark" style={`font-size:${Math.round(size * 0.5)}px`}>
          Auto<span class="aw-mut">Warehouse</span>
        </span>
        {tagline && <span class="aw-tag">agent flows · model holds</span>}
      </span>
    </span>
  )
}

<style>
  .aw-lockup {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--ink);
  }
  .aw-mark {
    flex: none;
    color: var(--ink);
  }
  .aw-words {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }
  .aw-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .aw-mut {
    opacity: 0.55;
  }
  .aw-tag {
    margin-top: 3px;
    font: 700 8px var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
</style>
